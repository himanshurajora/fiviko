// Fiviko — Prisma schema (Phase 1 MVP). See fiviko.md §19.
// Enum string values mirror the union types in @fiviko/shared.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum FinancialPersonality {
  CAREFUL_SAVER
  BALANCED_PLANNER
  DREAM_BUILDER
  AGGRESSIVE_ACHIEVER
}

enum AssetType {
  BANK_BALANCE
  CASH
  GOLD
  STOCKS
  MUTUAL_FUNDS
  CRYPTO
  PROPERTY
  VEHICLE
  BUSINESS_ASSET
  OTHER
}

enum LiquidityType {
  LIQUID
  SEMI_LIQUID
  ILLIQUID
}

enum LiabilityType {
  PERSONAL_LOAN
  EDUCATION_LOAN
  CREDIT_CARD_DEBT
  VEHICLE_LOAN
  HOME_LOAN
  BORROWED_MONEY
  OTHER
}

enum IncomeType {
  SALARY
  FREELANCE
  BUSINESS
  PASSIVE_INCOME
  OTHER
}

enum Frequency {
  MONTHLY
  YEARLY
  ONE_TIME
}

enum MandatoryExpenseCategory {
  RENT
  INSURANCE
  FOOD
  GROCERIES
  TRAVEL
  EDUCATION
  SUBSCRIPTIONS
  UTILITIES
  LOAN_EMI
  OTHER
}

enum ExpenseCategory {
  FOOD
  GROCERIES
  TRANSPORT
  SHOPPING
  ENTERTAINMENT
  HEALTH
  BILLS
  EDUCATION
  TRAVEL
  SUBSCRIPTIONS
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  WALLET
  OTHER
}

enum NeedOrWant {
  NEED
  WANT
}

enum SyncStatus {
  SYNCED
  PENDING
}

enum GoalType {
  SHORT_TERM
  LONG_TERM
}

enum GoalCategory {
  HOUSE
  CAR
  BIKE
  LAPTOP
  PHONE
  EDUCATION
  BUSINESS_EQUIPMENT
  TRAVEL
  HEALTH
  FAMILY
  HOBBY
  LUXURY
  EMERGENCY_FUND
  OTHER
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
  ABANDONED
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
}

enum Recommendation {
  BUY_NOW
  WAIT
  REDUCE_BUDGET
  NOT_RECOMMENDED
  HARD_WARNING
}

enum StreakType {
  SAVING
  EXPENSE_LOGGING
  UNDER_BUDGET
  NO_IMPULSE
}

enum ChallengeType {
  DAILY
  MONTHLY
}

enum UserChallengeStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  passwordHash         String
  baseCurrency         String                @default("USD")
  financialPersonality FinancialPersonality?
  onboardingCompleted  Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  assets            Asset[]
  liabilities       Liability[]
  incomes           Income[]
  mandatoryExpenses MandatoryExpense[]
  expenses          Expense[]
  goals             Goal[]
  badges            UserBadge[]
  streaks           Streak[]
  challenges        UserChallenge[]
  incomeHistory     IncomeHistory[]
  netWorthHistory   NetWorthHistory[]
  categoryBudgets   CategoryBudget[]
  cashFlows         CashFlow[]
}

/// Optional monthly spending cap per expense category (spec §8.4 budget vs actual).
model CategoryBudget {
  id            String          @id @default(cuid())
  userId        String
  category      ExpenseCategory
  /// Monthly limit in the user's base currency.
  monthlyLimit  Decimal         @db.Decimal(18, 2)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

model Asset {
  id                 String        @id @default(cuid())
  userId             String
  type               AssetType
  name               String
  amount             Decimal       @db.Decimal(18, 2)
  currency           String
  /// Cached conversion to base currency at last update. The live view always
  /// reconverts from `amount` + `currency` via the latest CurrencyRate; this
  /// field is only kept for legacy reads and snapshots.
  baseCurrencyAmount Decimal       @db.Decimal(18, 2)
  liquidityType      LiquidityType @default(LIQUID)
  /// Soft-delete tombstone. List endpoints filter out non-null. Restored by undo.
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  balances  AssetBalanceEntry[]

  @@index([userId])
}

/// Immutable per-day balance log for an asset (native amount). Powers the
/// net-worth tracker, per-asset history charts, and reconstructable history.
model AssetBalanceEntry {
  id         String   @id @default(cuid())
  userId     String
  assetId    String
  /// Asset's native amount on `recordedAt` (currency comes from the parent asset).
  amount     Decimal  @db.Decimal(18, 2)
  recordedAt DateTime
  /// Stable kind tag — "manual", "deposit", "transfer-in", "transfer-out",
  /// "salary-auto:YYYY-MM", "loan-payment", "receipt:YYYY-MM" etc.
  source     String   @default("manual")
  /// Free-text human note ("Mom's birthday gift", "Rent transferred to landlord").
  note       String?
  /// Pairs two entries from a transfer so the UI can show them as one row.
  transferId String?
  createdAt  DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@index([assetId, recordedAt])
  @@index([transferId])
}

model Liability {
  id                          String        @id @default(cuid())
  userId                      String
  type                        LiabilityType
  name                        String
  outstandingAmount           Decimal       @db.Decimal(18, 2)
  /// What you owed when this debt was first added — the denominator for
  /// "% paid down" progress and the Debt Crusher badge. Never decreases as
  /// you pay it down; only changes if the user explicitly edits it. Nullable
  /// only because pre-existing rows had no value at migration time; treat null
  /// as "same as outstandingAmount" in the DTO layer.
  originalOutstandingAmount   Decimal?      @db.Decimal(18, 2)
  monthlyPayment              Decimal       @db.Decimal(18, 2)
  currency                    String
  baseCurrencyOutstandingAmount Decimal     @db.Decimal(18, 2)
  baseCurrencyMonthlyPayment  Decimal       @db.Decimal(18, 2)
  interestRate                Float?
  deletedAt                   DateTime?
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Income {
  id                 String     @id @default(cuid())
  userId             String
  type               IncomeType
  /// Optional human label so a user with two FREELANCE sources can tell them
  /// apart ("Acme contract", "Flink driving Berlin"). Falls back to the type
  /// label in the UI when blank.
  name               String?
  /// Modelled/expected per-period amount. Variable-income users override per
  /// month via IncomeReceipt, and the auto-deposit cron prefers that actual.
  amount             Decimal    @db.Decimal(18, 2)
  currency           String
  baseCurrencyAmount Decimal    @db.Decimal(18, 2)
  frequency          Frequency  @default(MONTHLY)
  /// When set, the monthly executor credits this asset by `amount` (or the
  /// actual receipt amount if logged) each month. Cross-currency is OK — the
  /// cron converts at the moment of credit using the latest FX rate.
  depositToAssetId   String?
  /// YYYY-MM of the month the credit was last applied — guards against doubles.
  lastDepositedMonth String?
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipts IncomeReceipt[]

  @@index([userId])
}

/// What actually arrived for a given income in a given period (YYYY-MM).
/// Gig drivers, freelancers and anyone with variable pay log this; the cron
/// then credits the auto-deposit account with the actual figure instead of
/// the modelled one. Source of truth for "expected vs actual" charts.
model IncomeReceipt {
  id                 String   @id @default(cuid())
  userId             String
  incomeId           String
  /// YYYY-MM (period the money is *for*, not when it was logged).
  periodKey          String
  /// What the user logged, in the income's native currency.
  amount             Decimal  @db.Decimal(18, 2)
  currency           String
  baseCurrencyAmount Decimal  @db.Decimal(18, 2)
  /// "manual" (user-logged actual) or "auto" (cron stamped the modelled amount).
  source             String   @default("manual")
  receivedAt         DateTime @default(now())
  note               String?
  createdAt          DateTime @default(now())

  income Income @relation(fields: [incomeId], references: [id], onDelete: Cascade)

  @@unique([incomeId, periodKey])
  @@index([userId, periodKey])
}

model MandatoryExpense {
  id                 String                   @id @default(cuid())
  userId             String
  category           MandatoryExpenseCategory
  amount             Decimal                  @db.Decimal(18, 2)
  currency           String
  baseCurrencyAmount Decimal                  @db.Decimal(18, 2)
  frequency          Frequency                @default(MONTHLY)
  deletedAt          DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Per-month income record for historical reporting (spec §16). Auto-seeded
/// from recurring income each month, but editable for variable-income months.
model IncomeHistory {
  id                 String   @id @default(cuid())
  userId             String
  /// YYYY-MM
  month              String
  baseCurrencyAmount Decimal  @db.Decimal(18, 2)
  /// "auto" = snapshotted from recurring income; "manual" = user-set.
  source             String   @default("auto")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId])
}

model Expense {
  id                 String          @id @default(cuid())
  userId             String
  amount             Decimal         @db.Decimal(18, 2)
  currency           String
  baseCurrencyAmount Decimal         @db.Decimal(18, 2)
  category           ExpenseCategory
  note               String?
  date               DateTime        @default(now())
  paymentMethod      PaymentMethod   @default(CASH)
  isRecurring        Boolean         @default(false)
  needOrWant         NeedOrWant      @default(NEED)
  linkedGoalId       String?
  syncStatus         SyncStatus      @default(SYNCED)
  /// Stable client-generated id used to de-duplicate offline-synced entries.
  clientId           String?
  deletedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedGoal  Goal? @relation(fields: [linkedGoalId], references: [id], onDelete: SetNull)

  @@unique([userId, clientId])
  @@index([userId, date])
}

model Goal {
  id                             String       @id @default(cuid())
  userId                         String
  name                           String
  type                           GoalType
  category                       GoalCategory
  targetAmount                   Decimal      @db.Decimal(18, 2)
  currency                       String
  baseCurrencyTargetAmount       Decimal      @db.Decimal(18, 2)
  currentSavedAmount             Decimal      @default(0) @db.Decimal(18, 2)
  baseCurrencyCurrentSavedAmount Decimal      @default(0) @db.Decimal(18, 2)
  targetDate                     DateTime?
  priority                       GoalPriority @default(MEDIUM)
  expectedMaintenanceCost        Decimal?     @db.Decimal(18, 2)
  expectedResaleValue            Decimal?     @db.Decimal(18, 2)
  isReplacingExistingItem        Boolean      @default(false)
  notes                          String?
  status                         GoalStatus   @default(ACTIVE)
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  scoreInput     GoalScoreInput?
  recommendation GoalRecommendation?
  linkedExpenses Expense[]

  @@index([userId])
}

model GoalScoreInput {
  id                 String   @id @default(cuid())
  goalId             String   @unique
  incomeImpact       Int
  productivity       Int
  happiness          Int
  necessity          Int
  urgency            Int
  dreamLuxury        Int
  timeSaving         Int
  frequencyOfUse     Int
  careerGrowth       Int
  healthWellbeing    Int
  familySocialImpact Int
  regretRisk         Int
  maintenanceBurden  Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model GoalRecommendation {
  id                      String         @id @default(cuid())
  goalId                  String         @unique
  purchaseReadinessScore  Float
  financialSafetyScore    Float
  personalValueScore      Float
  futureBenefitScore      Float
  riskScore               Float
  goalConflictScore       Float
  recommendation          Recommendation
  safeBudgetMin           Decimal        @db.Decimal(18, 2)
  safeBudgetMax           Decimal        @db.Decimal(18, 2)
  recommendedPurchaseDate DateTime?
  monthlySavingRequired   Decimal        @db.Decimal(18, 2)
  explanation             String
  /// JSON blob of ScoreFactor[] and GoalConflict[] for the detail view.
  breakdown               Json?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model Badge {
  id              String      @id @default(cuid())
  /// Stable code used by seed + unlock logic (e.g. FIRST_GOAL).
  code            String      @unique
  name            String
  description     String
  icon            String
  unlockCondition String
  createdAt       DateTime    @default(now())

  users      UserBadge[]
  challenges Challenge[]
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Streak {
  id            String     @id @default(cuid())
  userId        String
  type          StreakType
  currentCount  Int        @default(0)
  longestCount  Int        @default(0)
  lastUpdatedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model Challenge {
  id            String        @id @default(cuid())
  code          String        @unique
  title         String
  description   String
  type          ChallengeType
  targetValue   Float
  rewardBadgeId String?
  createdAt     DateTime      @default(now())

  rewardBadge Badge?          @relation(fields: [rewardBadgeId], references: [id], onDelete: SetNull)
  users       UserChallenge[]
}

model UserChallenge {
  id          String              @id @default(cuid())
  userId      String
  challengeId String
  progress    Float               @default(0)
  status      UserChallengeStatus @default(IN_PROGRESS)
  startedAt   DateTime            @default(now())
  completedAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
}

model CurrencyRate {
  id           String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Float
  source       String   @default("manual")
  updatedAt    DateTime @updatedAt

  @@unique([fromCurrency, toCurrency])
}

/// Tracks when periodic jobs (e.g. currency sync) last ran, so the task
/// executor can be throttled (e.g. currency at most once/day). Keyed by job name.
model SyncState {
  id        String   @id @default(cuid())
  key       String   @unique
  lastRunAt DateTime
  meta      String?
}

/// Unified signed log of every money movement in base currency. Each row is a
/// single in/out event at the moment it happened — auto-deposits, windfalls,
/// transfers, loan pay-downs, expenses logged, income receipts. Decouples
/// "this month's flow" reporting from the balance-entry deltas (which mix
/// absolute "set" updates with real movements). Append-only by convention.
model CashFlow {
  id          String   @id @default(cuid())
  userId      String
  /// Always positive — `kind` carries the sign convention.
  baseAmount  Decimal  @db.Decimal(18, 2)
  /// "INCOME_CREDIT" "WINDFALL_IN" "RECEIPT_IN" "TRANSFER_IN" "TRANSFER_OUT"
  /// "EXPENSE_OUT" "PAY_DOWN_OUT". Inflows end in _IN/_CREDIT, outflows _OUT.
  kind        String
  occurredAt  DateTime
  /// Free-text note for traceability and the UI.
  note        String?
  /// Originating entity for click-through (e.g. ref="income:abc" / "expense:xyz").
  refKind     String?
  refId       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([userId, kind])
}

/// Daily net-worth snapshot for the net-worth trend chart (spec §16). Written
/// by the daily executor cron and on every manual balance update.
model NetWorthHistory {
  id               String   @id @default(cuid())
  userId           String
  /// YYYY-MM-DD
  date             String
  netWorth         Decimal  @db.Decimal(18, 2)
  liquidNetWorth   Decimal  @db.Decimal(18, 2)
  totalAssets      Decimal  @db.Decimal(18, 2)
  totalLiabilities Decimal  @db.Decimal(18, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}
