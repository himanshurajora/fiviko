# PostgreSQL connection (matches docker-compose.yml — host port 5544)
DATABASE_URL="postgresql://fiviko:fiviko@localhost:5544/fiviko?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Auth — CHANGE THIS in production to a long random string
JWT_SECRET="dev-only-change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:5173"

# Shared secret for /api/internal/* (task executor). Must match the executor's value.
INTERNAL_API_TOKEN="dev-internal-token-change-me-please"

# OpenAI key for the AI features (monthly report, coach, explanations, tips).
OPENAI_API_KEY="your-openai-api-key-here"

# currencylayer key — used by the task executor (copy it there too).
CURRENCY_LAYER_API_KEY="your-currency-layer-api-key-here"
