# Main Fiviko API base URL (the executor talks ONLY to this — never the DB).
MAIN_API_URL="http://localhost:4000"

# Shared secret; must match the backend's INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN="dev-internal-token-change-me-please"

# currencylayer access key (free tier: 100 requests/month). Copy from backend .env.
CURRENCY_LAYER_API_KEY="your-currencylayer-key-here"

# Currency is fetched at most once per this many hours (server also enforces it).
CURRENCY_MIN_INTERVAL_HOURS=24
